SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
# JWT signing alg. HS256 (legacy shared secret) or ES256/RS256 (asymmetric signing keys, verified via JWKS).
# Supabase projects with signing keys enabled — including local `supabase start` — use ES256.
SUPABASE_JWT_ALG=HS256
ENVIRONMENT=production

# Comma-separated extra CORS origins beyond https://grounded.app.
# Add specific Vercel preview URLs here — never use a wildcard.
# Example: ALLOWED_ORIGINS=https://grounded-abc123-myteam.vercel.app
ALLOWED_ORIGINS=
